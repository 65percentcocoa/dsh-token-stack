{
  "name": "dsh-token-stack",
  "version": "0.1.0",
  "description": "Cross-session memory + token-efficiency stack for DeepSeek Harness (DSH): capture tool evidence, compress it into facts/preferences/constraints, inject once per session, terse output, and filter tool-output noise — with native settings toggles.",
  "type": "module",
  "main": "index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "cross-session",
    "token-efficiency",
    "claude-mem",
    "caveman"
  ],
  "author": "65percentcocoa",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "prepublishOnly": "node --check index.js && node --check lib/index.js && node --check lib/client.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  }
}
